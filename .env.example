# Copy this file to .env and fill in your key.

# --- LLM provider -----------------------------------------------------------
# "anthropic" (Claude, default) or "gemini"
LLM_PROVIDER=anthropic

# Claude API key: create one at https://console.anthropic.com (Settings > API keys).
ANTHROPIC_API_KEY=

# One exact model ID, used for Dr. Lee, the judge and the scorer.
# Run `python manage.py list_models` to see the IDs your key can use, pick one,
# and do NOT change it after pilot stage P4. Record it in the paper.
#   claude-sonnet-5-5  : default; better role-play, still cheap for this study
#   claude-haiku-5-5   : cheapest and fastest; test it in pilot P1 if latency is a problem
LLM_MODEL=claude-sonnet-5-5

# Claude effort level: low / medium / high. "low" keeps replies fast (pilot target <= 4 s).
# Note: the current Claude API has no temperature setting, so TEMP_* values below apply to Gemini only.
LLM_EFFORT=low

# Only needed if LLM_PROVIDER=gemini (also: pip install google-genai)
GEMINI_API_KEY=
GEMINI_THINKING=

# Set to 1 to run without any API calls (fake Dr. Lee) for testing the interface.
LLM_MOCK=0

# --- Study timing (seconds) and limits. Provisional until the pilot. ---------
ROUND_SECONDS=240
ROUND_MAX_MESSAGES=5
BREAK_SECONDS=60
ADAPTIVE_START_LEVEL=2
ASSIGNMENT_SEED=2026
# Main-study sequences (5 participants). P01, P06, P08 form a balanced square.
MAIN_SEQUENCES=1,6,8,10,15
PRACTICE_ROUNDS=3
# Optional one-line reflection between practice rounds (1 = on, 0 = off). Same for every design.
REFLECTION_PROMPT=0

# --- Which laptop is this? (needed when more than one laptop runs sessions) ----
# Each laptop owns its own main sequences, so participant IDs never clash and the data can be merged.
# Laptop A: STATION=A and STATION_SEQUENCES=1,8,15
# Laptop B: STATION=B and STATION_SEQUENCES=6,10
# Pilot IDs include the station letter (PILOTA03, PILOTB04), so pilots never clash either.
STATION=A
STATION_SEQUENCES=

# --- Django ------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
